{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "stopOnEntry": false,
            "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}"],
            "outFiles": ["${workspaceFolder}/src/**/*.js"],
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
